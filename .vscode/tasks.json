            },
            "problemMatcher": {
                "owner": "nasm",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Link libatoi",
            "type": "shell",
            "command": "clang",
            "args": [
                "-shared",
                "-fPIC",
                "-g",
                "${workspaceFolder}/build/atoi.o",
                "-o",
                "${workspaceFolder}/bin/libatoi.so"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build libatoi",
            "dependsOn": [
                "Assemble atoi",
