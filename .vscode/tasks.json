                    "message": 4
                }
            }
        },
        {
            "label": "Link input_sum",
            "type": "shell",
            "command": "clang",
            "args": [
                "-g",
                "-pie",
                "${workspaceFolder}/build/input_sum.o",
                "-o",
                "${workspaceFolder}/bin/input_sum",
                "-L${workspaceFolder}/bin",
                "-litoa",
                "-latoi",
                "-Wl,-rpath,'$ORIGIN'"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build input_sum",
            "dependsOn": [
                "Build libitoa",
                "Build libatoi",
                "Assemble input_sum",
                "Link input_sum"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
