{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ensure Build Directories",
            "type": "shell",
            "command": "mkdir -p build bin",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Assemble itoa",
            "type": "shell",
            "command": "nasm",
            "args": [
                "-f",
                "elf64",
                "numbers/itoa.s",
                "-o",
                "${workspaceFolder}/build/itoa.o"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "nasm",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Link libitoa",
            "type": "shell",
            "command": "clang",
            "args": [
                "-shared",
                "-fPIC",
                "-g",
                "${workspaceFolder}/build/itoa.o",
                "-o",
                "${workspaceFolder}/bin/libitoa.so"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build libitoa",
            "dependsOn": [
                "Assemble itoa",
                "Link libitoa"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Assemble atoi",
            "type": "shell",
            "command": "nasm",
            "args": [
                "-f",
                "elf64",
