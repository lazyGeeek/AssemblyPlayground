            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Assemble input_sum",
            "type": "shell",
            "command": "nasm",
            "args": [
                "-f",
                "elf64",
                "numbers/input_sum.s",
                "-o",
                "${workspaceFolder}/build/input_sum.o"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
